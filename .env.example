# ================================================================
# AgriVoice Backend — скопируй в .env и заполни своими ключами
#   cp .env.example .env
# ================================================================

# --- Gemini (Google AI Studio: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=AIza...

# --- Supabase (https://supabase.com → New project) ---
# После создания проекта: Project Settings → Data API
#   SUPABASE_URL = Project URL
#   SUPABASE_KEY = anon / public ключ (Project Settings → API Keys)
# Не забудь выполнить supabase_schema.sql в SQL Editor!
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=eyJ...

# --- Twilio (https://twilio.com/try-twilio) ---
# Console → Account Info: Account SID + Auth Token
# Phone Numbers → Buy a Number → купи US-номер (+1...)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...
# Голос для звонков (русский TTS). Варианты: Polly.Tatyana, Polly.Maxim
TWILIO_VOICE=Polly.Tatyana

# --- URL-ы деплоя ---
# BACKEND_URL нужен Twilio-вебхукам чтобы строить callback-ссылки
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
